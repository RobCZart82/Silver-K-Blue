# Apply the VST3 processing-mode fix to an isolated JUCE source copy.
if(NOT DEFINED SILVER_JUCE_VST3_SOURCE OR NOT EXISTS "${SILVER_JUCE_VST3_SOURCE}")
    message(FATAL_ERROR "SILVER_JUCE_VST3_SOURCE must point to JUCE's VST3 client source")
endif()

file(READ "${SILVER_JUCE_VST3_SOURCE}" vst3_text)
foreach(mode_source newSetup data)
    set(realtime_only "setNonRealtime (${mode_source}.processMode == Vst::kOffline)")
    set(non_realtime "setNonRealtime (${mode_source}.processMode != Vst::kRealtime)")
    string(FIND "${vst3_text}" "${non_realtime}" patched_position)
    if(patched_position EQUAL -1)
        string(FIND "${vst3_text}" "${realtime_only}" original_position)
        if(original_position EQUAL -1)
            message(FATAL_ERROR "Unrecognized JUCE VST3 processing-mode adapter for ${mode_source}")
        endif()
        string(REPLACE "${realtime_only}" "${non_realtime}" vst3_text "${vst3_text}")
    endif()
endforeach()
file(WRITE "${SILVER_JUCE_VST3_SOURCE}" "${vst3_text}")
